{
  "compilerOptions": {
    "target": "ES2017",
    "module": "None",
    "lib": ["DOM", "ES2017"],
    "outDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outFile": "./game.js"
  },
  "include": ["translations.ts", "game.ts"],
  "exclude": ["node_modules", "tests"]
}