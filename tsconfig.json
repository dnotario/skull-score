{
  "compilerOptions": {
    "target": "ES2017",
    "module": "None",
    "lib": ["DOM", "ES2017"],
    "outDir": "./build/runFiles",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outFile": "./build/runFiles/game.js"
  },
  "include": ["translations.ts", "game.ts"],
  "exclude": ["node_modules", "tests", "build"]
}