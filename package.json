{
  "name": "skull-king-score-keeper",
  "version": "1.0.0",
  "description": "A pirate-themed score keeper for the Skull King card game",
  "main": "game.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:visual",
    "test:unit": "jest --selectProjects unit",
    "test:visual": "node scripts/run-visual-tests.js",
    "test:visual:update": "node scripts/run-visual-tests.js --update-golden",
    "test:watch": "jest --watch",
    "build:cache-bust": "node scripts/update-cache-bust.js",
    "build:tsc": "tsc",
    "build:copy": "mkdir -p build/runFiles && cp index.html styles.css sw.js manifest.json robots.txt sitemap.xml build/runFiles/ && cp favicon.ico icon-16.png icon-32.png icon-192.png icon-512.png apple-touch-icon.png icon.svg skull_logo.png og-image.png twitter-image.png build/runFiles/ 2>/dev/null || true",
    "build": "rm -rf build/runFiles && npm run build:tsc && npm run build:copy && npm run build:cache-bust",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.ts"
        ],
        "collectCoverageFrom": [
          "**/*.ts",
          "!**/*.d.ts",
          "!**/node_modules/**",
          "!**/tests/**"
        ],
        "globals": {
          "ts-jest": {
            "tsconfig": "tsconfig.test.json"
          }
        }
      },
      {
        "displayName": "visual",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/visual/**/*.test.ts"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/visual/helpers/matchers.ts"
        ],
        "globals": {
          "ts-jest": {
            "tsconfig": "tsconfig.test.json"
          }
        },
        "maxWorkers": 4
      }
    ]
  }
}
