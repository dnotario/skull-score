{
  "name": "skull-king-score-keeper",
  "version": "1.0.0",
  "description": "A pirate-themed score keeper for the Skull King card game",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "parcel build index.html --dist-dir dist",
    "dev": "parcel index.html --dist-dir dist",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.15.2",
    "@parcel/transformer-jsonld": "^2.15.2",
    "@parcel/transformer-webmanifest": "^2.15.2",
    "@types/jest": "^30.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "parcel": "^2.10.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ]
  },
  "dependencies": {
    "preact": "^10.19.0"
  }
}
